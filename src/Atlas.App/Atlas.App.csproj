<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><UseWPF>true</UseWPF><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>AtlasCollectionManager</AssemblyName><Version>0.21.5</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Atlas.Core/Atlas.Core.csproj"/></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Assets/*.jpg" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Assets/Hero/*.jpg" /></ItemGroup>
  <ItemGroup><AssemblyMetadata Include="NexusApplicationSlug" Value="$(NexusApplicationSlug)" /></ItemGroup>
</Project>
